{
  "name": "agent-dual-proxy",
  "version": "0.7.1",
  "description": "Local dual-path proxy for CLI agents: auto-selects a gateway that reaches the model endpoint, verifies the channel, fails over to direct",
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./agents": "./src/agents.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gambn/agent-dual-proxy.git"
  },
  "homepage": "https://github.com/gambn/agent-dual-proxy#readme",
  "bugs": {
    "url": "https://github.com/gambn/agent-dual-proxy/issues"
  },
  "author": "Gambn",
  "bin": {
    "agent-gateway": "bin/agent-gateway.js",
    "dual-proxy": "bin/dual-proxy.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/dual-proxy.js"
  },
  "dependencies": {
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "docs",
    "contrib"
  ],
  "keywords": [
    "proxy",
    "failover",
    "cli-agent",
    "claude-code",
    "codex",
    "gemini",
    "health-check"
  ]
}
